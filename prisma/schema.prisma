generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SimulationProcessType {
  ASRS
  FORKLIFT
}

model SimulationRun {
  id             String                @id
  processType    SimulationProcessType
  startedAt      DateTime
  completedAt    DateTime
  durationMs     Int
  completedPhase String
  message        String
  loadsCompleted Int
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([processType, completedAt])
  @@index([completedAt])
}
